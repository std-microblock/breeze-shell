#include <windows.h>

#define VER_FILEVERSION ${VERSION_MAJOR},${VERSION_MINOR},${VERSION_ALTER},0
#define VER_FILEVERSION_STR "${VERSION}\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "breeze-shell"
            VALUE "FileDescription", "Breeze Shell"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "shell.dll"
            VALUE "OriginalFilename", "shell.dll"
            VALUE "ProductName", "Breeze Shell"
            VALUE "ProductVersion", VER_FILEVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
